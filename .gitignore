# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code (personal local settings)
.claude/settings.local.json
# 作業用 worktree はリポジトリの複製なので、コミットもテスト収集もさせない
# （vitest.config.ts の exclude と対。片方だけでは塞げない）
.claude/worktrees/

# playwright（実行結果。基準画像 playwright/__screenshots__/ は commit する）
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# typescript
*.tsbuildinfo
next-env.d.ts
